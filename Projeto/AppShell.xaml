<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Projeto.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Projeto"
    FlyoutBehavior="Flyout"
    Title="Projeto"
>
    <!-- FlyoutItem and MenuItem Template -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <HorizontalStackLayout Spacing="10" Padding="15, 5, 15, 20"  BackgroundColor="Transparent">
                <Image Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding Title}" FontSize="16" />
            </HorizontalStackLayout>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <HorizontalStackLayout Spacing="10" Padding="15, 5, 15, 20" BackgroundColor="Transparent">
                <Image Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding Text}" FontSize="16" />
            </HorizontalStackLayout>
        </DataTemplate>
    </Shell.MenuItemTemplate>
    
    <!-- //////////////////////// -->

    <Shell.FlyoutHeader>
        <HorizontalStackLayout 
            Padding="15, 20, 15, 35"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
        >
            <Label Text="Menu" FontSize="18" FontAttributes="Bold" />
        </HorizontalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Ínicio" Icon="house.svg">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="home" />
    </FlyoutItem>

    <MenuItem Text="Aparência" IconImageSource="palette.svg" Clicked="OnAppearencePageClicked" />

    <Shell.FlyoutFooter>
        <Label Text="Desenvolvido por: Gabriel Ribeiro" HorizontalTextAlignment="Center" Margin="0,0,0,5" />
    </Shell.FlyoutFooter>
</Shell>
