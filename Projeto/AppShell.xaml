<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Projeto.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Projeto"
    FlyoutBehavior="Flyout"
    Title="Projeto"
>
    <!-- FlyoutItem Template -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <HorizontalStackLayout Spacing="10" Padding="15, 5, 15, 5"  BackgroundColor="Transparent">
                <Image 
                Source="{Binding Icon}" 
                WidthRequest="20" 
                HeightRequest="20" 
            />

                <Label Text="{Binding Title}" FontSize="16" />
            </HorizontalStackLayout>
        </DataTemplate>
    </Shell.ItemTemplate>
    
    <!-- //////////////////////// -->

    <Shell.FlyoutHeader>
        <HorizontalStackLayout 
            Padding="15, 20, 15, 35"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
        >
            <Label Text="Menu" FontSize="18" FontAttributes="Bold" />
        </HorizontalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Ínicio" Icon="house.svg">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="home" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Label Text="Desenvolvido por: Gabriel Ribeiro" HorizontalTextAlignment="Center" Margin="0,0,0,5" />
    </Shell.FlyoutFooter>
</Shell>
