<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Color x:Key="Primary">#0D8A6A</Color>
    <Color x:Key="PrimaryDark">#4DD9B0</Color>
    <Color x:Key="PrimaryDarkText">#003528</Color>
    <Color x:Key="Secondary">#DDF5EC</Color>
    <Color x:Key="SecondaryDarkText">#7FDFC0</Color>
    <Color x:Key="Tertiary">#06614B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0B2B24</Color>
    <Color x:Key="OffBlack">#1E2226</Color>

    <Color x:Key="Gray100">#E4E7E9</Color>
    <Color x:Key="Gray200">#C7CCD0</Color>
    <Color x:Key="Gray300">#AAB1B6</Color>
    <Color x:Key="Gray400">#8E969C</Color>
    <Color x:Key="Gray500">#6B747A</Color>
    <Color x:Key="Gray600">#3E464C</Color>
    <Color x:Key="Gray900">#16191C</Color>
    <Color x:Key="Gray950">#0F1113</Color>

    <!-- =========================================================
         CAMADAS DE SUPERFICIE
         Canvas  = fundo da pagina
         Surface = cartoes, flyout
         Elevated= navbar, sheets
         High    = hover, selecionado
         ========================================================= -->
    <Color x:Key="CanvasLight">#F7F8F8</Color>
    <Color x:Key="CanvasDark">#0F1113</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#16191C</Color>

    <Color x:Key="SurfaceElevatedLight">#F0F2F2</Color>
    <Color x:Key="SurfaceElevatedDark">#1E2226</Color>

    <Color x:Key="SurfaceHighLight">#E6E9EA</Color>
    <Color x:Key="SurfaceHighDark">#272C31</Color>

    <Color x:Key="OutlineLight">#E3E6E7</Color>
    <Color x:Key="OutlineDark">#2C3238</Color>
    <Color x:Key="OutlineStrongLight">#CBD1D3</Color>
    <Color x:Key="OutlineStrongDark">#3B434A</Color>

    <!-- =========================================================
         TEXTO
         ========================================================= -->
    <Color x:Key="TextPrimaryLight">#101314</Color>
    <Color x:Key="TextPrimaryDark">#E8ECEF</Color>
    <Color x:Key="TextSecondaryLight">#4F585E</Color>
    <Color x:Key="TextSecondaryDark">#9AA4AD</Color>
    <Color x:Key="TextMutedLight">#7B858B</Color>
    <Color x:Key="TextMutedDark">#6B757E</Color>

    <!-- =========================================================
         ACCENT CONTAINER
         ========================================================= -->
    <Color x:Key="AccentContainerLight">#DDF5EC</Color>
    <Color x:Key="AccentContainerDark">#1E2E2A</Color>
    <Color x:Key="OnAccentContainerLight">#044635</Color>
    <Color x:Key="OnAccentContainerDark">#A6EFD6</Color>

    <!-- =========================================================
         STATUS
         ========================================================= -->
    <Color x:Key="SuccessLight">#3D7A24</Color>
    <Color x:Key="SuccessDark">#8EDC72</Color>
    <Color x:Key="WarningLight">#9A6B00</Color>
    <Color x:Key="WarningDark">#E8B54A</Color>
    <Color x:Key="DangerLight">#C03B3B</Color>
    <Color x:Key="DangerDark">#FF7B7B</Color>

    <!-- =========================================================
         BRUSHES SEMANTICOS
         Uma chave so, ja resolve os dois temas.
         ========================================================= -->
    <SolidColorBrush x:Key="CanvasBrush"
        Color="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
    <SolidColorBrush x:Key="SurfaceBrush"
        Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"
        Color="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
    <SolidColorBrush x:Key="SurfaceHighBrush"
        Color="{AppThemeBinding Light={StaticResource SurfaceHighLight}, Dark={StaticResource SurfaceHighDark}}" />
    <SolidColorBrush x:Key="OutlineBrush"
        Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
    <SolidColorBrush x:Key="AccentBrush"
        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <SolidColorBrush x:Key="AccentContainerBrush"
        Color="{AppThemeBinding Light={StaticResource AccentContainerLight}, Dark={StaticResource AccentContainerDark}}" />

    <!-- =========================================================
         COMPATIBILIDADE com o template padrao
         ========================================================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>
