<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Projeto.Components"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Projeto.AppearencePage"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
>
    <ScrollView>
        <VerticalStackLayout>
            <Grid RowDefinitions="Auto,*">
                <components:PageHeader Grid.Row="0" Title="Aparência" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Padding="15, 25, 15, 10">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Image 
                        Source="{AppThemeBinding Light=moon_light.png, Dark=moon_dark.png}" 
                        HeightRequest="25"
                        WidthRequest="25"
                        VerticalOptions="Center"
                    />

                    <Label VerticalOptions="Center" Text="Modo Escuro" FontSize="16" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <RadioButton 
                    Grid.Column="1" 
                    x:Name="RbDark" 
                    GroupName="Theme" 
                    CheckedChanged="OnThemeChanged"
                    VerticalOptions="Center" 
                />
            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray" 
            />

            <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Padding="15, 15, 15, 10">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Image 
                        Source="{AppThemeBinding Light=sun_light.png, Dark=sun_dark.png}" 
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="Center"
                    />

                    <Label VerticalOptions="Center" Text="Modo Claro" FontSize="16" FontAttributes="Bold" />
                </HorizontalStackLayout>

                <RadioButton 
                    x:Name="RbLight" 
                    GroupName="Theme"
                    CheckedChanged="OnThemeChanged"
                    VerticalOptions="Center" 
                    Grid.Column="1" 
                />
            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray" 
            />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15" Grid.Row="1" Padding="15, 15, 15, 15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Grid.Column="0">
                    <Image 
                        Source="{AppThemeBinding Light=smartphone_light.png, Dark=smartphone_dark.png}" 
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="Center"
                        Grid.Column="0"
                    />

                    <VerticalStackLayout Grid.Column="1"  Spacing="5">
                        <Label VerticalOptions="Center" Text="Configuração do celular" FontSize="16" FontAttributes="Bold" />
                        
                        <Label 
                            Text="O aplicativo usará as mesmas configurações do seu celular." 
                            FontSize="14" 
                        />
                    </VerticalStackLayout>
                </Grid>

                <RadioButton 
                    x:Name="RbSystem" 
                    GroupName="Theme" 
                    VerticalOptions="Center" 
                    CheckedChanged="OnThemeChanged"
                    Grid.Column="1" 
                />
            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray" 
            />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>