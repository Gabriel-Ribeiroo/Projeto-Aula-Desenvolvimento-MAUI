<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Projeto.Components"
    x:Class="Projeto.AppearencePage"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
>
    <ScrollView>
        <VerticalStackLayout>
            <Grid RowDefinitions="Auto,*">
                <components:PageHeader Grid.Row="0" Title="Aparência" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Padding="15, 25, 15, 10">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Image 
                        Source="moon.svg"
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="Center"
                    />

                    <Label VerticalOptions="Center" Text="Modo Escuro" FontSize="16" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <RadioButton Grid.Column="1" x:Name="RbDark" GroupName="Theme" VerticalOptions="Center" />
            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray" 
            />

            <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Padding="15, 15, 15, 10">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Image 
                        Source="sun.svg"
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="Center"
                    />

                    <Label VerticalOptions="Center" Text="Modo Claro" FontSize="16" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <RadioButton Grid.Column="1" x:Name="RbLight" GroupName="Theme" VerticalOptions="Center" />
            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="Gray" 
            />

            <Grid ColumnDefinitions="*,Auto" Grid.Row="1" ColumnSpacing="30" Padding="15, 15, 15, 10">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <Image 
                         Source="smartphone.svg"
                         WidthRequest="25"
                         HeightRequest="25"
                         VerticalOptions="Center"
                    />

                    <VerticalStackLayout Spacing="5">
                        <Label VerticalOptions="Center" Text="Configuração do celular" FontSize="16" FontAttributes="Bold" />
                        <Label Text="O aplicativo usará as mesmas configurações do seu celular." FontSize="12" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <RadioButton Grid.Column="1" x:Name="RbSystem" GroupName="Theme" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>