<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Projeto.Components"
    x:Class="Projeto.ModelsPage"
>
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="20,18,20,12" Spacing="2">
            <Label Text="Modelos" FontSize="28" FontAttributes="Bold"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <Label x:Name="LblCount" Text="" FontSize="13"
            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="ModelsList" Margin="20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <components:Card 
                        Title="{Binding Name}" 
                        Subtitle="{Binding Description}"
                        EditClicked="OnEditClicked"
                        DeleteClicked="OnDeleteButtonClicked"
                    />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Nenhum modelo cadastrado." 
               HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Button 
            Grid.Row="2" 
            Margin="20,12,20,20"
            Text="+  Novo modelo"
            FontSize="16" 
            FontAttributes="Bold"
            Padding="16,15"
            CornerRadius="14" 
            BorderWidth="0"
            Clicked="OnAddModelClicked"
            Background="{StaticResource AccentBrush}"
            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
        />
    </Grid>
</ContentPage>