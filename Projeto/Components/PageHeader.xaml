<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Projeto.Components"
             x:Class="Projeto.Components.PageHeader"
             x:Name="Root"
>
    <Grid 
        x:DataType="components:PageHeader"
        BindingContext="{x:Reference Root}"
        HeightRequest="56"
        Padding="8,0"
        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
    >

        <Label 
            Text="{Binding Title}"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            LineBreakMode="TailTruncation"
            Margin="48,0" 
        />

        <ImageButton 
            Source="{AppThemeBinding Light=arrow_left_light.png, Dark=arrow_left_dark.png}"
            IsVisible="{Binding ShowBackButton}"
            WidthRequest="40"
            HeightRequest="40"
            Padding="8"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Clicked="OnBackClicked" 
        />
    </Grid>
</ContentView>