<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projeto.DeveloperPage">
    <Grid RowDefinitions="Auto, *, Auto" Padding="20, 40, 20, 40">

        <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
            <Image 
                Source="{AppThemeBinding Light=engine_light.png, Dark=engine_dark.png}" 
                HeightRequest="35"
                WidthRequest="35"
                VerticalOptions="Center"
            />
            <Label 
                Text="SysVeicular"
                Style="{StaticResource Headline}"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center"
                SemanticProperties.HeadingLevel="Level1"
            />
        </HorizontalStackLayout>

        <Border Grid.Row="1" 
                VerticalOptions="Center" 
                HorizontalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0, 10" Radius="15" Opacity="0.1" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12" Padding="25, 30">

                <Label Text="Gabriel Ribeiro dos Santos" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />

                <Label Text="RA: 2507390" 
                       FontSize="15" 
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#B0BEC5}" 
                       Margin="0, 0, 0, 10" />

                <Border HorizontalOptions="Center" 
                        BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#2C3E50}"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        Padding="15, 6">
                    <Label Text="30/09/2026" 
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" />
                </Border>

            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="2" 
                Text="Ínicio" 
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="50"
                HorizontalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="Black"
                Clicked="OnHomePageButtonClicked" />
    </Grid>
</ContentPage>